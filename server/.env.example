PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5176

# Remote PostgreSQL. When this is set, DB_HOST is not used.
# DATABASE_URL=postgres://avnadmin:YOUR_AIVEN_PASSWORD@pg-18aac1dc-aicareyuautomation-76ba.a.aivencloud.com:16363/ProjectManagementSystem?sslmode=require&uselibpqcompat=true

# Local PostgreSQL. Used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careyu_pms
DB_USER=
DB_PASSWORD=
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=10000

JWT_SECRET=

# SMTP (optional). Used when database email settings are empty.
# Prefer saving settings in Admin Settings or Email Reports → Email Configuration.
# Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CareYu Automation
SMTP_SECURE=false

# Public WebSocket URL when the site is hosted separately from the API.
# Firebase Hosting cannot upgrade /ws, so the browser connects here directly.
# REALTIME_PUBLIC_URL=wss://careyu-api-804127909103.asia-south1.run.app/ws
